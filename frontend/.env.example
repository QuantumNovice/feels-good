# Copy this file to .env.local and paste the PUBLIC project token from PostHog.
# Never put a personal API key or a project secret API key here.
VITE_POSTHOG_PROJECT_TOKEN=
# US Cloud: https://us.i.posthog.com / EU Cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional kill switch; an empty token also disables analytics.
VITE_POSTHOG_ENABLED=true
# Development previews do not send events unless explicitly enabled.
VITE_POSTHOG_CAPTURE_IN_DEV=false
