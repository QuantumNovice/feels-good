{
  "name": "neu-joh-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:all": "pnpm test && pnpm test:ui"
  },
  "dependencies": {
    "@dpawlikowski/liquid-glass": "0.3.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "leaflet": "1.9.4",
    "posthog-js": "1.444.0",
    "reka-ui": "^2.11.0",
    "vue": "3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.20",
    "@vitejs/plugin-vue": "5",
    "autoprefixer": "10.4.21",
    "postcss": "^8.5.31",
    "prettier": "3",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "^6.4.5",
    "vue-tsc": "2"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "overrides": {
      "postcss-selector-parser": "7.1.6"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
